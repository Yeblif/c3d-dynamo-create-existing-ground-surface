    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import clr\r\nimport System\r\nfrom System.Reflection import BindingFlags\r\n\r\nclr.AddReference(\"AcMgd\")\r\nclr.AddReference(\"AcCoreMgd\")\r\nfrom Autodesk.AutoCAD.ApplicationServices import Application\r\n\r\nsurface_name = str(IN[0])\r\npg_in = IN[1]\r\n\r\n# Normalize PG names\r\nif pg_in is None:\r\n    pg_names = []\r\nelif isinstance(pg_in, list):\r\n    pg_names = [str(x) for x in pg_in]\r\nelse:\r\n    pg_names = [str(pg_in)]\r\n\r\nacad_com = Application.AcadApplication  # __ComObject\r\n\r\ndef invoke(obj, member, args=None, flags=None, step=\"\"):\r\n    if args is None:\r\n        args = []\r\n    if flags is None:\r\n        flags = BindingFlags.InvokeMethod | BindingFlags.GetProperty\r\n    try:\r\n        return obj.GetType().InvokeMember(\r\n            member,\r\n            flags,\r\n            None,\r\n            obj,\r\n            System.Array[System.Object](list(args))\r\n        )\r\n    except Exception as e:\r\n        inner = getattr(e, \"InnerException\", None)\r\n        inner_msg = str(inner) if inner else \"\"\r\n        raise Exception(\r\n            \"FAILED at step: {}\\nMember: {}\\nArgs: {}\\nFlags: {}\\nError: {}\\nInner: {}\".format(\r\n                step, member, args, int(flags), str(e), inner_msg\r\n            )\r\n        )\r\n\r\ndef try_get(obj, member, flags, args=None):\r\n    try:\r\n        return invoke(obj, member, args=args or [], flags=flags, step=member)\r\n    except:\r\n        return None\r\n\r\n# Civil 3D COM app (your known working ProgID)\r\naecc_app = invoke(\r\n    acad_com,\r\n    \"GetInterfaceObject\",\r\n    [\"AeccXUiLand.AeccApplication.13.6\"],\r\n    flags=BindingFlags.InvokeMethod,\r\n    step=\"GetInterfaceObject\"\r\n)\r\n\r\naecc_doc = invoke(aecc_app, \"ActiveDocument\", flags=BindingFlags.GetProperty, step=\"ActiveDocument\")\r\n\r\n# Collections\r\nsurfaces = invoke(aecc_doc, \"Surfaces\", flags=BindingFlags.GetProperty, step=\"aecc_doc.Surfaces\")\r\ndoc_pointgroups = invoke(aecc_doc, \"PointGroups\", flags=BindingFlags.GetProperty, step=\"aecc_doc.PointGroups\")\r\n\r\n# --- Get surface (Surfaces.Item(name) is a PROPERTY in your setup) ---\r\naecc_surf = invoke(surfaces, \"Item\", [surface_name], flags=BindingFlags.GetProperty, step=\"Surfaces.Item(name)\")\r\n\r\n# Surface.PointGroups collection\r\nsurf_pointgroups = invoke(aecc_surf, \"PointGroups\", flags=BindingFlags.GetProperty, step=\"surface.PointGroups\")\r\n\r\n# --- Enumerate point groups and find by Name ---\r\ndef find_pointgroup_by_name(pg_collection, target_name):\r\n    # Try Count first\r\n    cnt = try_get(pg_collection, \"Count\", BindingFlags.GetProperty)\r\n    if cnt is None:\r\n        raise Exception(\"PointGroups collection has no Count property (can't enumerate).\")\r\n\r\n    # Access individual groups by index.\r\n    # Some COM collections expose Item(index) as PROPERTY, some as METHOD.\r\n    for i in range(int(cnt)):\r\n        pg = try_get(pg_collection, \"Item\", BindingFlags.GetProperty, [i])\r\n        if pg is None:\r\n            pg = try_get(pg_collection, \"Item\", BindingFlags.InvokeMethod, [i])\r\n        if pg is None:\r\n            raise Exception(\"PointGroups collection doesn't support Item(index) via property or method.\")\r\n\r\n        n = try_get(pg, \"Name\", BindingFlags.GetProperty)\r\n        if n is not None and str(n).upper() == target_name.upper():\r\n            return pg\r\n\r\n    return None\r\n\r\nadded, failed = [], []\r\n\r\nfor name in pg_names:\r\n    try:\r\n        pg_obj = find_pointgroup_by_name(doc_pointgroups, name)\r\n        if pg_obj is None:\r\n            failed.append(\"{} | not found during enumeration\".format(name))\r\n            continue\r\n\r\n        # Add to surface definition\r\n        invoke(surf_pointgroups, \"Add\", [pg_obj], flags=BindingFlags.InvokeMethod, step=\"surface.PointGroups.Add(pg)\")\r\n        added.append(name)\r\n\r\n    except Exception as e:\r\n        failed.append(\"{} | {}\".format(name, str(e)))\r\n\r\n# Update surface\r\ntry:\r\n    invoke(aecc_surf, \"Update\", flags=BindingFlags.InvokeMethod, step=\"surface.Update()\")\r\nexcept Exception as e:\r\n    failed.append(\"Update failed | \" + str(e))\r\n\r\nOUT = {\r\n    \"surface\": surface_name,\r\n    \"attempted\": pg_names,\r\n    \"added\": added,\r\n    \"failed\": failed\r\n}\r\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "d0f00b16f18b47f1b5e9030ba3c314ad",
