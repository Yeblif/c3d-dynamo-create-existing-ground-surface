    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import clr\r\nclr.AddReference('AcMgd')\r\nclr.AddReference('AcDbMgd')\r\nclr.AddReference('AcCoreMgd')\r\n\r\nfrom Autodesk.AutoCAD.ApplicationServices import Application\r\nfrom Autodesk.AutoCAD.DatabaseServices import (\r\n    BlockTableRecord,\r\n    OpenMode,\r\n    DBPoint\r\n)\r\n\r\ndoc = Application.DocumentManager.MdiActiveDocument\r\ndb = doc.Database\r\n\r\npts = []\r\n\r\ntm = db.TransactionManager\r\ntr = tm.StartTransaction()\r\n\r\ntry:\r\n    bt = tr.GetObject(db.BlockTableId, OpenMode.ForRead)\r\n    ms_id = bt.get_Item(BlockTableRecord.ModelSpace)\r\n    ms = tr.GetObject(ms_id, OpenMode.ForRead)\r\n\r\n    for oid in ms:\r\n        ent = tr.GetObject(oid, OpenMode.ForRead)\r\n        if isinstance(ent, DBPoint):\r\n            p = ent.Position\r\n            layer = ent.Layer  # <-- layer name\r\n            pts.append([p.X, p.Y, p.Z, layer])\r\n\r\n    tr.Commit()\r\nfinally:\r\n    pass\r\n\r\nOUT = pts\r\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "0ab4c9db523d408a90ee5e996cdda345",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "c7790bf0253b453f8823ec8034a9ba61",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
