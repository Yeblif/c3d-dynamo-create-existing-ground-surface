        {
          "Id": "01d35fd3c46a4b289c3a835b2bcbbf77",
          "Name": "list",
          "Description": "Flattened list by amount",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Auto",
      "Description": "Flattens a nested list of lists by a certain amount.\n\nList.Flatten (list: var[]..[], amount: int = -1): var[]..[]"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import clr\r\nclr.AddReference(\"AcMgd\")\r\nclr.AddReference(\"AcCoreMgd\")\r\nclr.AddReference(\"AcDbMgd\")\r\nclr.AddReference(\"AeccDbMgd\")\r\n\r\nfrom Autodesk.AutoCAD.ApplicationServices import Application\r\nfrom Autodesk.AutoCAD.DatabaseServices import OpenMode, ObjectIdCollection\r\n\r\n\r\n# ----------------------------\r\n# Inputs\r\n# ----------------------------\r\n# IN[0] = surface (TinSurface Dynamo object OR ObjectId)\r\n# IN[1] = nested featurelines (list of lists) OR a single list (will be wrapped)\r\n# IN[2] = descriptions (list of strings) OR a single string (will be wrapped)\r\n# IN[3] = midOrdinateDistance (optional) default 0.1\r\n# IN[4] = maximumDistance    (optional) default 10\r\n# IN[5] = weedingDistance    (optional) default 0.1\r\n# IN[6] = weedingAngle       (optional) default 0.5\r\n\r\nsurface_in = IN[0]\r\nfl_nested  = IN[1]\r\ndescs      = IN[2]\r\n\r\n\r\n# ----------------------------\r\n# Helpers\r\n# ----------------------------\r\ndef to_object_id(x):\r\n    # Dynamo Civil 3D objects usually expose InternalObjectId\r\n    if hasattr(x, \"InternalObjectId\"):\r\n        return x.InternalObjectId\r\n    if hasattr(x, \"ObjectId\"):\r\n        return x.ObjectId\r\n    return x  # assume already an ObjectId\r\n\r\ndef ensure_list(x):\r\n    return x if isinstance(x, list) else [x]\r\n\r\ndef normalize_nested_list(x):\r\n    # ensures list-of-lists\r\n    if x is None:\r\n        return []\r\n    if not isinstance(x, list):\r\n        return [[x]]\r\n    if len(x) == 0:\r\n        return []\r\n    if isinstance(x[0], list):\r\n        return x\r\n    return [x]\r\n\r\ndef get_val(x, default):\r\n    if x is None:\r\n        return float(default)\r\n    try:\r\n        return float(x)\r\n    except:\r\n        return float(default)\r\n\r\n\r\n# ----------------------------\r\n# Defaults (your requested values)\r\n# ----------------------------\r\nmidOrd   = get_val(IN[3], 0.1)\r\nmaxDist  = get_val(IN[4], 10.0)\r\nweedDist = get_val(IN[5], 0.1)\r\nweedAng  = get_val(IN[6], 0.5)\r\n\r\n\r\n# ----------------------------\r\n# Normalize inputs\r\n# ----------------------------\r\nfl_nested = normalize_nested_list(fl_nested)\r\ndescs = ensure_list(descs)\r\n\r\n# Fail fast if mismatched counts (prevents wrong descriptions applied)\r\nif len(descs) != len(fl_nested):\r\n    OUT = \"ERROR: descriptions length ({}) must match number of featureline sublists ({})\".format(len(descs), len(fl_nested))\r\nelse:\r\n    adoc = Application.DocumentManager.MdiActiveDocument\r\n    db = adoc.Database\r\n\r\n    surf_id = to_object_id(surface_in)\r\n\r\n    results = []\r\n    lock = adoc.LockDocument()\r\n    try:\r\n        tr = db.TransactionManager.StartTransaction()\r\n        try:\r\n            surf = tr.GetObject(surf_id, OpenMode.ForWrite)\r\n\r\n            # Add each sublist as ONE breakline operation, then set its Description\r\n            for sublist, desc in zip(fl_nested, descs):\r\n                ids = ObjectIdCollection()\r\n                for fl in ensure_list(sublist):\r\n                    ids.Add(to_object_id(fl))\r\n\r\n                # Civil 3D Surface Definition operation\r\n                op = surf.BreaklinesDefinition.AddStandardBreaklines(\r\n                    ids, midOrd, maxDist, weedDist, weedAng\r\n                )\r\n                op.Description = str(desc)\r\n\r\n                results.append(op)\r\n\r\n            tr.Commit()\r\n            OUT = {\r\n                \"Surface\": surface_in,\r\n                \"AddedOperations\": len(results)\r\n            }\r\n\r\n        finally:\r\n            pass\r\n    finally:\r\n        lock.Dispose()\r\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "22b6a0b8db71493ea809a8c46906af6e",
      "Inputs": [
        {
          "Id": "284dc8eecb7243efbb66373183ba03fb",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "9671b4a8b708404c815deb82bc2b5f93",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "35486fb0d79c42f5a434926a823ee849",
          "Name": "IN[2]",
          "Description": "Input #2",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "7122e7efc3d24fb590d3b1495cc33237",
          "Name": "IN[3]",
          "Description": "Input #3",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "518c0ca263f343a2990269119bdd3b50",
          "Name": "IN[4]",
          "Description": "Input #4",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "4171f4ccb43c4b4c9c6cff63a00f416d",
          "Name": "IN[5]",
          "Description": "Input #5",
