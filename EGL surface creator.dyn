    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import clr\r\nclr.AddReference('AcMgd')\r\nclr.AddReference('AcDbMgd')\r\nclr.AddReference('AeccDbMgd')\r\n\r\nfrom Autodesk.AutoCAD.ApplicationServices import Application\r\nfrom Autodesk.AutoCAD.DatabaseServices import OpenMode\r\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\r\nfrom Autodesk.Civil.DatabaseServices import FeatureLine\r\n\r\ndef ensure_list(x):\r\n    return x if isinstance(x, list) else [x]\r\n\r\ndef unwrap_id(obj):\r\n    try:\r\n        return obj.InternalObjectId\r\n    except:\r\n        return obj  # might already be ObjectId or a plain string\r\n\r\ndef is_site_object(x):\r\n    # Dynamo Site objects will typically have InternalObjectId\r\n    return hasattr(x, \"InternalObjectId\")\r\n\r\ndef clean_name(x):\r\n    # only use this for REAL strings\r\n    if x is None:\r\n        return None\r\n    return str(x).strip()\r\n\r\nfeatureLines = ensure_list(IN[0])\r\nsitesOrNames = ensure_list(IN[1])\r\n\r\n# allow single site/name applied to all\r\nif len(sitesOrNames) == 1 and len(featureLines) > 1:\r\n    sitesOrNames = sitesOrNames * len(featureLines)\r\n\r\nif len(featureLines) != len(sitesOrNames):\r\n    OUT = ([], [\"ERROR: featureLines and sitesOrNames must match in length (or provide one site/name)\"])\r\n    raise Exception(\"Length mismatch\")\r\n\r\ndoc = Application.DocumentManager.MdiActiveDocument\r\ncivilDoc = CivilApplication.ActiveDocument\r\ndb = doc.Database\r\n\r\nmoved = []\r\nreport = []\r\n\r\nlock = doc.LockDocument()\r\ntry:\r\n    tr = db.TransactionManager.StartTransaction()\r\n    try:\r\n        # Build name -> siteId lookup once (only used if input is a string)\r\n        siteIdByName = {}\r\n        for sid in civilDoc.GetSiteIds():\r\n            s = tr.GetObject(sid, OpenMode.ForRead)\r\n            siteIdByName[s.Name] = sid\r\n\r\n        for flObj, siteIn in zip(featureLines, sitesOrNames):\r\n\r\n            if flObj is None:\r\n                moved.append(None)\r\n                report.append(\"Skipped: FeatureLine is None\")\r\n                continue\r\n\r\n            flId = unwrap_id(flObj)\r\n\r\n            # Determine destination site ObjectId\r\n            if is_site_object(siteIn):\r\n                destSiteId = unwrap_id(siteIn)  # Site object's InternalObjectId\r\n                destDesc = \"Site object\"\r\n            else:\r\n                siteName = clean_name(siteIn)\r\n                if not siteName or siteName not in siteIdByName:\r\n                    moved.append(flObj)\r\n                    report.append(\"Site not found: {}\".format(siteName))\r\n                    continue\r\n                destSiteId = siteIdByName[siteName]\r\n                destDesc = siteName\r\n\r\n            try:\r\n                # ✅ STATIC per your API docs\r\n                FeatureLine.MoveToSite(flId, destSiteId)\r\n                report.append(\"Moved OK -> {}\".format(destDesc))\r\n            except Exception as e:\r\n                report.append(\"FAILED -> {} : {}\".format(destDesc, str(e)))\r\n\r\n            moved.append(flObj)\r\n\r\n        tr.Commit()\r\n    finally:\r\n        tr.Dispose()\r\nfinally:\r\n    lock.Dispose()\r\n\r\nOUT = (moved, report)\r\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "1aa021badf5b452ab3d23089e37db71b",
      "Inputs": [
        {
          "Id": "f8af6497d0464abea94d57166f4334c0",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "ddbbc401e25f4f9eb451239e364338ce",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "fc7b786634d246e3a1c7ce9e1559cd6d",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
